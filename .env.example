# Supabase — 검색 RPC + 상품 메타
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-jwt>

# Modal — FashionSigLIP 임베딩 엔드포인트
MODAL_EMBED_URL=<your-modal-embed-url>
MODAL_EMBED_TOKEN=<your-modal-bearer-token>

# LiteLLM Proxy — Vision/LLM 라우팅
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=<your-litellm-master-key>

# Langfuse — 관측성
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>

# AI 서버 호출 인증 (Next.js → AI 서버) — 비어두면 인증 스킵 (dev only)
INTERNAL_API_TOKEN=<random-32-byte-hex>

# Image URL 화이트리스트 (콤마 구분) — SSRF 방지. 비어두면 검증 스킵 (dev only)
ALLOWED_IMAGE_HOSTS=
