# ── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Supabase / PostgREST shim ──────────────────────────────────────────────
DB_URL=
DB_TOKEN=

# ── SPEC-MEMORY-001 — Postgres-backed memory persistence ───────────────────
# Wire-protocol DSN (psycopg3 style) to dev-app Postgres for user_session /
# user_taste_profile. Distinct from DB_URL (PostgREST HTTP shim).
ENV=development
DB_DSN=
MEMORY_POOL_MIN_SIZE=2
MEMORY_POOL_MAX_SIZE=10
# Set to "false" in production; "true" is dev-only (REQ-MEMORY-FALLBACK-002).
MEMORY_FALLBACK_ON_PROBE_FAIL=true
SESSION_CLEANUP_INTERVAL_S=300

# ── Modal (FashionSigLIP 임베딩) ────────────────────────────────────────────
MODAL_EMBED_URL=
MODAL_EMBED_TOKEN=
MODAL_EMBED_TIMEOUT=90.0

# ── LiteLLM Proxy ──────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# ── Langfuse ───────────────────────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SPEC-OBSERVABILITY-002 / REQ-OBS-COST-002 — emergency rollback. When true,
# drops @observe from 8 non-LLM-calling LangGraph nodes (keeps the 4 LLM nodes).
LANGFUSE_SELECTIVE_MODE=false

# ── 검색 파라미터 ──────────────────────────────────────────────────────────
SEARCH_DEFAULT_K=50
SEARCH_BRAND_CAP=2
SEARCH_PLATFORM_CAP=3
SEARCH_FINAL_LIMIT=15

# ── enhance_query (SPEC-PIPELINE-001) ──────────────────────────────────────
ENHANCE_QUERY_ENABLED=false
ENHANCE_QUERY_MODEL=gpt-4o-mini
ENHANCE_QUERY_TIMEOUT_MS=1500
ENHANCE_QUERY_MAX_TOKENS=200
ENHANCE_QUERY_TEMPERATURE=0.2
PIPELINE_PARALLEL_ENABLED=true

# ── 보안 ───────────────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=
ALLOWED_IMAGE_HOSTS=

# ── Messenger 채널 (SPEC-MSG-001) ──────────────────────────────────────────
MESSENGER_BACKEND=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PUBLIC_URL=
VISION_MODEL=gpt-4o-mini
BOT_LANGUAGE=en
SESSION_TTL_SECONDS=1800

# ── Routing-LLM ────────────────────────────────────────────────────────────
ROUTER_MODEL=gpt-4o-mini
ROUTER_TIMEOUT_MS=1500
ROUTER_MAX_TOKENS=300
ROUTER_LLM_ENABLED=true

# ── Taste profile ──────────────────────────────────────────────────────────
TASTE_PROFILE_ENABLED=true
TASTE_PROFILE_TTL_SECONDS=2592000

# ── Critique ───────────────────────────────────────────────────────────────
CRITIQUE_CHEAPER_RATIO=0.7

# ── SPEC-AGENT-001 — LangGraph respond/ask_clarify ─────────────────────────
RESPONSE_MODEL=gpt-4o-mini
RESPONSE_TIMEOUT_MS=5000
RESPONSE_MAX_TOKENS=200
ASK_CLARIFY_MIN_DESC_TOKENS=3
ASK_CLARIFY_AMBIGUOUS_LABELS=item,clothing,thing,piece

# ── SPEC-VISION-UNIFY-001 — Rich Vision schema (portal/app parity) ─────────
VISION_SCHEMA_V2=true
VISION_MAX_TOKENS=2500
VISION_TEMPERATURE=0.3
VISION_TIMEOUT_S=30
ASK_CLARIFY_MIN_QUERY_TOKENS=4
ASK_CLARIFY_AMBIGUOUS_SUBCATEGORIES=item,clothing,thing,piece

# ── SPEC-AGENTIC-CRITIQUE-001 — Self-critique loop ─────────────────────────
SELF_CRITIQUE_ENABLED=true
SELF_CRITIQUE_MAX_ITERATIONS=2
SELF_CRITIQUE_THRESHOLD=0.6
SELF_CRITIQUE_TIMEOUT_S=30
SELF_CRITIQUE_FASTPATH_DROP_FILTERS=min_price,max_price,exclude_keywords
EVALUATOR_MODEL=gpt-4o-mini
EVALUATOR_MAX_TOKENS=400
EVALUATOR_TEMPERATURE=0.2
EVALUATOR_TIMEOUT_S=8

# ── SPEC-CLARIFY-CARDS-001 — Inline-keyboard clarify cards ────────────────
CLARIFY_CARDS_ENABLED=true
CLARIFY_MAX_BUTTONS=5

# ── SPEC-IMPLICIT-FB-001 — Implicit feedback capture ──────────────────────
# Weight invariant (informative): CLICK(1.0) > REQUERY(0.5) > NOCLICK(0.2) > decay(0.9)
IMPLICIT_FB_ATTRIBUTION_WINDOW_S=600
IMPLICIT_FB_REQUERY_WINDOW_S=90
IMPLICIT_FB_NOCLICK_WEIGHT=0.2
IMPLICIT_FB_CLICK_WEIGHT=1.0
IMPLICIT_FB_REQUERY_WEIGHT=0.5

# ── App identity (informational; rarely overridden) ──────────────────────
# PROJECT_NAME=kiko-ai-server
# VERSION=0.1.0

# ── DEMO_MODE — local-only POC short-circuit (video shoot 등) ─────────────
# search_node 가 DB/Modal 우회하고 fixture 후보 반환. 운영선 false.
# DEMO_MODE=false

# ── noscroll 벤치마크 — Response sentence split (P0) ─────────────────────
# LLM/fallback 응답을 문장 단위로 split + typing action + 짧은 딜레이.
# RESPONSE_SPLIT_ENABLED=true
# RESPONSE_SPLIT_DELAY_MS=350
# RESPONSE_SPLIT_MIN_CHARS=8

# ── SPEC-ONBOARD-CARDS-001 — Onboarding cards + Pinterest bootstrap ──────
# 카드 온보딩 (mood 12 / color 6 / fit 4 멀티셀렉트) + Pinterest A/B/C.
ONBOARDING_CARDS_ENABLED=true
# 온보딩 시드 가중치 cap (0, 1]. 기본 0.7.
ONBOARDING_SEED_MAX_WEIGHT=0.7
# Pinterest 부트스트랩 활성화. false 시 fit 단계에서 즉시 완료.
PINTEREST_BOOTSTRAP_ENABLED=true
# Pinterest 한 턴당 최대 핀 URL 수 (Mode C, [1, 50]).
PINTEREST_MAX_PINS_PER_TURN=20
# Pinterest 스크랩 결과 캐시 TTL (24h).
PINTEREST_INGEST_CACHE_TTL_S=86400
# 온보딩 후 continuous Pinterest 부트스트랩 rate-limit (5분).
PINTEREST_CONTINUOUS_RATELIMIT_S=300
# Apify scraper (Pinterest 보드/프로필 모드만 필요. Mode C 는 불필요).
# 비어있으면 board/profile 은 degraded — Mode C (개별 핀 URL) 만 동작.
APIFY_TOKEN=
APIFY_PINTEREST_ACTOR=epctex/pinterest-scraper
# Apify 한 호출당 최대 핀 수 [1, 100].
APIFY_PINTEREST_MAX_ITEMS=80
# Vision 배치 동시성 [1, 20].
APIFY_PINTEREST_CONCURRENCY=5
PINTEREST_CONTINUOUS_ENABLED=false

# ── SPEC-AGENT-V3-REACT — incremental enhancements (4 independent sub-flags) ─
# 모두 기본 false → 마스터 게이트(AGENT_V2_REACT_ENABLED) ON 이어도 V2 byte-identical.
# 단계적 롤아웃: 갭 1개씩 true 전환 + dev 스모크 후 prod.
# Gap1 — TasteProfile + 최근 N턴 자동 주입.
AGENT_V3_MEMORY_INJECTION_ENABLED=false
# Gap2 — search/refine 결과 Reflexion 평가 (evaluator 헬퍼 in-loop wrap).
AGENT_V3_REFLEXION_ENABLED=false
# Gap3 — 능동 제안 + suggest_next_step 8번째 tool.
AGENT_V3_PROACTIVE_ENABLED=false
# Gap4 — 크로스스레드 dislike 메모리 (마이그레이션 선행 필요).
AGENT_V3_DISLIKE_MEMORY_ENABLED=false
# Gap1 메모리 주입 페이로드 token cap (char 근사 ×4).
AGENT_V3_MEMORY_MAX_TOKENS=1500
