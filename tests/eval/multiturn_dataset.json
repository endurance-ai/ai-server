{
  "version": "1.0",
  "description": "Multi-turn blending evaluator. Each case represents an 'initial outfit context + modifier instruction'. The evaluator embeds the initial query as a stand-in for the origin image, blends it with the modifier (Level 2 weighted-sum), runs the v6 RPC, then scores the result candidates against `expected.outfit_preservation` (silhouette identity) and `expected.modifier_reflection` (intent uptake).",
  "metrics": {
    "identity_score": "fraction of top-k whose category matches expected.outfit_preservation.category",
    "modifier_score": "fraction of top-k whose name contains ANY token from expected.modifier_reflection.keywords",
    "harmonic_score": "2 * identity * modifier / (identity + modifier)"
  },
  "blending": {
    "alpha_default": 0.7,
    "note": "alpha is the weight on the initial vector; (1-alpha) on the modifier vector"
  },
  "cases": [
    {
      "id": "color_swap_001",
      "type": "color_swap",
      "initial_query": "grey oversized wool overcoat men",
      "modifier_query": "navy blue",
      "lang": "en",
      "expected": {
        "outfit_preservation": {
          "category": "outerwear",
          "keywords_any": ["coat", "overcoat", "outer"]
        },
        "modifier_reflection": {
          "from_attribute": "grey",
          "to_attribute": "navy blue",
          "keywords_any": ["blue", "navy", "indigo"]
        }
      }
    },
    {
      "id": "color_swap_002",
      "type": "color_swap",
      "initial_query": "black slim leather jacket men",
      "modifier_query": "beige tan",
      "lang": "en",
      "expected": {
        "outfit_preservation": {
          "category": "outerwear",
          "keywords_any": ["jacket", "leather"]
        },
        "modifier_reflection": {
          "from_attribute": "black",
          "to_attribute": "beige tan",
          "keywords_any": ["beige", "tan", "camel", "cream"]
        }
      }
    },
    {
      "id": "color_swap_003",
      "type": "color_swap",
      "initial_query": "white relaxed cotton t-shirt women",
      "modifier_query": "black",
      "lang": "en",
      "expected": {
        "outfit_preservation": {
          "category": "tops",
          "keywords_any": ["t-shirt", "tee", "shirt"]
        },
        "modifier_reflection": {
          "from_attribute": "white",
          "to_attribute": "black",
          "keywords_any": ["black"]
        }
      }
    },
    {
      "id": "color_swap_004",
      "type": "color_swap",
      "initial_query": "brown wide chino trousers men",
      "modifier_query": "olive green khaki",
      "lang": "en",
      "expected": {
        "outfit_preservation": {
          "category": "bottoms",
          "keywords_any": ["pants", "trousers", "chino"]
        },
        "modifier_reflection": {
          "from_attribute": "brown",
          "to_attribute": "olive green khaki",
          "keywords_any": ["olive", "green", "khaki"]
        }
      }
    },
    {
      "id": "color_swap_005",
      "type": "color_swap",
      "initial_query": "오버사이즈 회색 울 오버코트 남성",
      "modifier_query": "검정 블랙",
      "lang": "ko",
      "expected": {
        "outfit_preservation": {
          "category": "outerwear",
          "keywords_any": ["코트", "오버코트", "아우터", "coat"]
        },
        "modifier_reflection": {
          "from_attribute": "grey",
          "to_attribute": "black",
          "keywords_any": ["블랙", "검정", "black"]
        }
      }
    },
