{
  "version": "1.0",
  "description": "Kiko search-quality golden set. Each case represents a real or plausible user query (KO/EN text). The harness embeds the input via Modal, runs search_products_v6, and scores the top-K against `expected` attributes. Ground truth is attribute-based (subcategory/keywords/color/fit) not product_id — cheap to curate and forward-compatible with catalog growth. Add a `whitelist_ids` field on individual cases to enforce stricter ground truth over time.",
  "metrics": {
    "subcat_hit_at_k": "fraction of top-K whose subcategory ∈ expected.subcategory_any",
    "keyword_hit_at_k": "fraction of top-K whose name/brand matches ANY expected.keywords_any",
    "color_hit_at_k": "fraction of top-K whose name matches ANY expected.color_any",
    "fit_hit_at_k": "fraction of top-K whose name matches ANY expected.fit_any",
    "brand_diversity_at_k": "count of unique brands in top-K (higher = more diverse)",
    "distance_p50_at_k": "median distance of top-K (lower = more confident retrieval)",
    "quality_score": "geometric mean of subcat_hit and keyword_hit (single-number summary; 0 if either is 0)"
  },
  "notes": [
    "Cases with `gender` set expect the search-query augmentation path (see LAST QUERY pin). Leave unset to test the default omit-gender path.",
    "`expected.color_any`/`fit_any` are OPTIONAL — omit when the query doesn't imply them.",
    "Image (pin.it / IG) cases live under type='image_url' and are opt-in via --include-image (Modal image endpoint has cold-start; text-only runs are fast/deterministic)."
  ],
